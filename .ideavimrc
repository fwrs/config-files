let g:mapleader=' '
let g:camelcasemotion_key=','
let g:EasyMotion_do_mapping=0

set autoindent
set ideajoin
set iskeyword+=-
set hls
set ignorecase
set smartcase
set clipboard^=unnamedplus,ideaput
set shell=/opt/homebrew/bin/fish
set number
set relativenumber
set cursorline
set wrap
set breakindent
set easymotion

nnoremap x "_x
nnoremap <leader>+ <c-a>
xnoremap <leader>+ <c-a>
nnoremap <leader>- <c-x>
xnoremap <leader>- <c-x>
xmap an <Action>(EditorSelectWord)
xmap in <Action>(EditorUnSelectWord)
nnoremap <leader>n :nohl<cr>
nnoremap <c-l> :nohl<cr>
nnoremap <leader>l :set list!<cr>
nnoremap <leader>sv <c-w>v
nnoremap <leader>sh <c-w>s
nnoremap <leader>se <c-w>=
nnoremap <leader>sx <c-w>c
nnoremap <leader>to :tabnew<cr>
nnoremap <leader>tx :tabclose<cr>
nnoremap <leader>tn :tabn<cr>
nnoremap <leader>tp :tabp<cr>
nmap <leader>cp <Action>(CopyAbsolutePath)
nmap grr <Action>(FindUsages)
nmap gri <Action>(GotoImplementation)
nmap grt <Action>(GotoTypeDeclaration)
nmap K <Action>(QuickJavaDoc)
nmap gO <Action>(FileStructurePopup)
nmap ]d <Action>(GotoNextError)
nmap [d <Action>(GotoPreviousError)
nmap <c-w>d <Action>(ShowErrorDescription)
nmap gra <Action>(ShowIntentionActions)
xmap gra <Action>(ShowIntentionActions)
nmap grn <Action>(RenameElement)
nmap <leader>fmt <Action>(ReformatCode)
xmap <leader>fmt <Action>(ReformatCode)
nmap sa <Plug>YSurround
xmap sa <Plug>VSurround
nmap sd <Plug>DSurround
nmap sr <Plug>CSurround
nmap <leader>ha <Plug>(easymotion-jumptoanywhere)
xmap <leader>ha <Plug>(easymotion-jumptoanywhere)
omap <leader>ha <Plug>(easymotion-jumptoanywhere)
nmap <leader>hw <Plug>(easymotion-bd-w)
xmap <leader>hw <Plug>(easymotion-bd-w)
omap <leader>hw <Plug>(easymotion-bd-w)
nmap <leader>hs <Plug>(easymotion-bd-f)
xmap <leader>hs <Plug>(easymotion-bd-f)
omap <leader>hs <Plug>(easymotion-bd-f)
nmap ]h <Action>(VcsShowNextChangeMarker)
nmap [h <Action>(VcsShowPrevChangeMarker)

nnoremap ci/ T/vt/c
nnoremap di/ T/vt/d
nnoremap yi/ T/vt/y
nnoremap vi/ T/vt/
xnoremap i/ <esc>T/vt/
nnoremap gUi/ T/vt/gU
nnoremap gui/ T/vt/gu
nnoremap ca/ F/vf/c
nnoremap da/ F/vf/d
nnoremap ya/ F/vf/y
nnoremap va/ F/vf/
xnoremap a/ <esc>F/vf/
nnoremap gUa/ F/vf/gU
nnoremap gua/ F/vf/gu

Plug 'bkad/CamelCaseMotion'
Plug 'vim-scripts/argtextobj.vim'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-surround'
